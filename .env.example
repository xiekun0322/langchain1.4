# =============================================================================
# LangChain project environment variables example
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# ---------- LLM providers (uncomment the ones you use) ----------
# OpenAI / Azure OpenAI
# OPENAI_API_KEY=
# OPENAI_API_BASE=
# OPENAI_API_VERSION=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_VERSION=
# AZURE_OPENAI_DEPLOYMENT_NAME=

# Anthropic
# ANTHROPIC_API_KEY=

# Google Gemini / Vertex
# GOOGLE_API_KEY=
# VERTEX_PROJECT_ID=
# VERTEX_LOCATION=

# DeepSeek
# DEEPSEEK_API_KEY=

# Qianfan (Baidu)
# QIANFAN_AK=
# QIANFAN_SK=

# Aliyun DashScope / Tongyi
# DASHSCOPE_API_KEY=

# Volcengine Ark (Doubao)
# ARK_API_KEY=
# ARK_BASE_URL=

# Moonshot (Kimi)
# MOONSHOT_API_KEY=

# Zhipu (ChatGLM)
# ZHIPUAI_API_KEY=

# ---------- Embedding models ----------
# OPENAI_EMBEDDING_DEPLOYMENT=
# AZURE_EMBEDDING_DEPLOYMENT=
# HUGGINGFACEHUB_API_TOKEN=
# OLLAMA_BASE_URL=http://localhost:11434

# ---------- Vector stores ----------
# PINECONE_API_KEY=
# PINECONE_ENV=
# WEAVIATE_URL=
# WEAVIATE_API_KEY=
# CHROMA_SERVER_HOST=
# CHROMA_SERVER_HTTP_PORT=
# MILVUS_HOST=
# MILVUS_PORT=
# QDRANT_URL=
# QDRANT_API_KEY=
# PG_CONNECTION_STRING=

# ---------- Tools / agents ----------
# SERPAPI_API_KEY=
# SERPER_API_KEY=
# GOOGLE_CSE_ID=
# GOOGLE_API_KEY_SEARCH=
# WOLFRAM_ALPHA_APPID=
# TAVILY_API_KEY=

# ---------- Document loaders ----------
# NOTION_API_TOKEN=
# GITHUB_TOKEN=
# CONFLUENCE_API_TOKEN=
# JIRA_API_TOKEN=

# ---------- Tracing / observability ----------
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
# LANGCHAIN_PROJECT=
# LANGCHAIN_HUB_API_TOKEN=

# ---------- App settings ----------
# LOG_LEVEL=INFO
# DEBUG=false
